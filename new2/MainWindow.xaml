<Window x:Class="SystemGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Guardian"
        Height="820"
        Width="1240"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="System Guardian" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    <TextBlock Text="  |  Fresh Windows Cleanup Assistant" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="AnalyzeButton" Content="Analyze" Width="120" Height="38" Margin="0,0,10,0" Style="{StaticResource AccentButton}" Click="AnalyzeSystem_Click"/>
                    <Button x:Name="CleanButton" Content="Clean Selected" Width="150" Height="38" Margin="0,0,10,0" Style="{StaticResource AccentButton}" Click="FreshCleanup_Click"/>
                    <Button x:Name="RepairButton" Content="Run Repair" Width="140" Height="38" Style="{StaticResource SecondaryButton}" Click="RunRepair_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="System overview" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Text="Device" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.DeviceName}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Text="User" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.UserName}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <TextBlock Text="Windows" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.WindowsVersion}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <TextBlock Text="CPU" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.CpuName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Text="RAM" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.MemorySummary}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Width="220" Margin="0,0,12,8">
                                <TextBlock Text="Disk" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.AvailableDisk}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,8">
                                <TextBlock Text="Uptime" Foreground="{StaticResource SecondaryText}"/>
                                <TextBlock Text="{Binding SystemHealth.Uptime}" FontSize="18" FontWeight="SemiBold"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Cleanup recommendations" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding CleanupSummary}" Margin="0,0,0,8" Foreground="{StaticResource SecondaryText}"/>
                        <TextBlock Text="No cleanup categories are available." Foreground="{StaticResource SecondaryText}" Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CleanupItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListView ItemsSource="{Binding CleanupItems}" MaxHeight="240" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Clean" Width="55">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                    <GridViewColumn Header="Location" DisplayMemberBinding="{Binding Path}" Width="300"/>
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="110"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Health status" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding SystemHealth.HealthSummary}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Driver health: " Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding SystemHealth.DriverStatus}" Foreground="{StaticResource WarningColor}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Updates: " Foreground="{StaticResource SecondaryText}"/>
                            <TextBlock Text="{Binding SystemHealth.UpdateStatus}" Foreground="{StaticResource WarningColor}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Open Device Manager" Style="{StaticResource SecondaryButton}" Click="OpenDeviceManager_Click" Margin="0,0,8,0"/>
                            <Button Content="Windows Update" Style="{StaticResource SecondaryButton}" Click="OpenWindowsUpdate_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Startup items (read-only)" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Impact is not measured. Manage entries in Windows Settings." Foreground="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                        <Button Content="Manage startup apps in Settings" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OpenStartupSettings_Click"/>
                        <ListView ItemsSource="{Binding StartupEntries}" MaxHeight="180" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Source}" Foreground="{StaticResource SecondaryText}"/>
                                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Driver center" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <ListView ItemsSource="{Binding DriverStatusItems}" MaxHeight="180" Background="Transparent" BorderThickness="0">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="120"/>
                                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="90"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Repair tools" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ListView x:Name="RepairListView" ItemsSource="{Binding RepairActions}" MaxHeight="200" Background="Transparent" BorderThickness="0" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Repair" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="320"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Status" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="StatusText" Text="Ready for a clean system check. Select your action above." TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
